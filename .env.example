# Shared by all apps in local development. Copy to .env and fill in DATABASE_URL.
NODE_ENV=development

# Supabase Postgres — Project → Connect → "Session pooler" connection string (IPv4, port 5432).
# Do NOT use the transaction pooler (port 6543): it hung connections under load (docs/database.md).
# Replace [YOUR-PASSWORD] with the database password. Never commit the real value.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Free-tier poolers allow few connections; keep this small.
DATABASE_POOL_MAX=5

# Optional. Shared room registry + pub/sub when running several game-server nodes (and API rate
# limits later). Leave empty to run everything on one node without Redis.
# Optional. API: shared rate limits + caches across nodes. Game server: shared room registry.
REDIS_URL=

# API
API_PORT=4000
# The web app's origin: CORS, CSRF origin check and WebSocket origin check all use it.
WEB_ORIGIN=http://localhost:5173
# Reverse proxies in front of api/game-server in production (1 behind one load balancer)
TRUST_PROXY=0
# Path of the web app on WEB_ORIGIN (e.g. /game) for invite links. Empty at the root.
WEB_BASE_PATH=
# Global per-IP request budget for the API
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=30
MATCHMAKE_RATE_LIMIT_PER_MINUTE=60
# Signs login tokens. Generate your own: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-64-char-hex-string-from-openssl-rand-hex-32
# `console` = no SMS is sent; the code is shown in the web app (development only)
SMS_PROVIDER=console
# Optional: Google sign-in (Google Cloud → OAuth client ID, type Web). Leave empty to hide it.
# Google e-mails that are admins (comma-separated). Synced at every Google sign-in; others lose admin.
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Game server
# true = the game server also serves the API on its port (one free host). Default false.
SERVE_API=false
# Bot-hosted public tables (comma-separated names). Empty = none.
HOUSE_BOTS=
HOUSE_BOT_COINS=50000
HOUSE_BOT_DEPOSIT=20000
GAME_SERVER_PORT=2567

# Web (exposed to the browser — no secrets here)
# Sub-path hosting (https://site/game/): VITE_BASE_PATH=/game/ ; root hosting: leave empty.
VITE_BASE_PATH=
# Static host proxies /api/* to this origin (Netlify _redirects); then VITE_API_URL=https://<site>/api
VITE_API_PROXY_TARGET=
VITE_API_URL=http://localhost:4000
VITE_GAME_SERVER_URL=ws://localhost:2567
