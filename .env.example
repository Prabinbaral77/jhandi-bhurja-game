# Shared by all apps in local development. Copy to .env and fill in DATABASE_URL.
NODE_ENV=development

# Supabase Postgres — Project → Connect → "Session pooler" connection string (IPv4, port 5432).
# Replace [YOUR-PASSWORD] with the database password. Never commit the real value.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Free-tier poolers allow few connections; keep this small.
DATABASE_POOL_MAX=5

# Optional until M4 (lobby/presence). Leave empty to run without Redis.
REDIS_URL=

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Game server
GAME_SERVER_PORT=2567

# Web (exposed to the browser — no secrets here)
VITE_API_URL=http://localhost:4000
VITE_GAME_SERVER_URL=ws://localhost:2567
