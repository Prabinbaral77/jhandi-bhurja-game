# Shared by all apps in local development. Copy to .env and fill in DATABASE_URL.
NODE_ENV=development

# Supabase Postgres — Project → Connect → "Session pooler" connection string (IPv4, port 5432).
# Do NOT use the transaction pooler (port 6543): it hung connections under load (docs/database.md).
# Replace [YOUR-PASSWORD] with the database password. Never commit the real value.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Free-tier poolers allow few connections; keep this small.
DATABASE_POOL_MAX=5

# Optional. Shared room registry + pub/sub when running several game-server nodes (and API rate
# limits later). Leave empty to run everything on one node without Redis.
REDIS_URL=

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Signs login tokens. Generate your own: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-64-char-hex-string-from-openssl-rand-hex-32
# `console` = no SMS is sent; the code is shown in the web app (development only)
SMS_PROVIDER=console
# Optional: Google sign-in (Google Cloud → OAuth client ID, type Web). Leave empty to hide it.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Game server
GAME_SERVER_PORT=2567

# Web (exposed to the browser — no secrets here)
VITE_API_URL=http://localhost:4000
VITE_GAME_SERVER_URL=ws://localhost:2567
