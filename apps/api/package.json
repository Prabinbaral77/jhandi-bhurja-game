{
  "name": "@jhandi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "reconcile": "tsx --env-file=../../.env src/scripts/reconcile.ts",
    "admin:grant": "tsx --env-file=../../.env scripts/grantAdmin.ts",
    "admin:revoke": "tsx --env-file=../../.env scripts/revokeAdmin.ts",
    "db:reset": "tsx --env-file=../../.env scripts/dbReset.ts",
    "dev:topup": "tsx --env-file=../../.env scripts/devTopUp.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6"
  },
  "dependencies": {
    "@jhandi/auth": "workspace:*",
    "@jhandi/db": "workspace:*",
    "@jhandi/game-rules": "workspace:*",
    "@jhandi/ledger": "workspace:*",
    "@jhandi/protocol": "workspace:*",
    "@trpc/server": "^11.19.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pino": "^10.4.0",
    "rate-limit-redis": "^6.0.2",
    "zod": "^4.6.7"
  }
}
