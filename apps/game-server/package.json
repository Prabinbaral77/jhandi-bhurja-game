    "@colyseus/schema": "5.0.41",
    "@colyseus/ws-transport": "0.18.4",
    "@jhandi/auth": "workspace:*",
    "@jhandi/db": "workspace:*",
    "@jhandi/game-rules": "workspace:*",
    "@jhandi/ledger": "workspace:*",
    "@jhandi/protocol": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
